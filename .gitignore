# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
covenant-*.tar


# Fixture project build artefacts (test/fixtures/example_project)
/test/fixtures/example_project/_build/
/test/fixtures/mutate/vm_project/_build/
/test/fixtures/example_project/tmp/
/test/fixtures/example_project/contracts/coverage.json
/test/fixtures/example_project/contracts/coverage.static.json

# Umbrella fixture build artefacts (test/fixtures/umbrella_project)
/test/fixtures/umbrella_project/_build/
/test/fixtures/umbrella_project/tmp/
/test/fixtures/umbrella_project/contracts/coverage.json
/test/fixtures/umbrella_project/contracts/coverage.static.json

# Umbrella fixture app output (test/fixtures/umbrella_project/apps/shop)
/test/fixtures/umbrella_project/apps/shop/tmp/

# Editor tooling
.elixir_ls/

# Sibling-layout fixture build artefacts (test/fixtures/sibling_project)
/test/fixtures/sibling_project/_build/
/test/fixtures/sibling_project/tmp/
/test/fixtures/sibling_project/contract/coverage.json
/test/fixtures/sibling_project/contract/coverage.static.json
